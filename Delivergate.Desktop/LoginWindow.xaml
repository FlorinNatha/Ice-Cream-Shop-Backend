<Window x:Class="Delivergate.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delivergate - Ice Cream Shop Login" Height="580" Width="440"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="#0F172A" FontFamily="Segoe UI">
    <Grid>
        <!-- Background Gradient Card -->
        <Border Margin="24" Background="#1E293B" CornerRadius="12" Padding="28" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header Branding -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <TextBlock Text="🍦" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Delivergate" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center"/>
                    <TextBlock Text="Ice Cream Shop Portal" FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Error Notification -->
                <Border Grid.Row="1" x:Name="ErrorNotification" Background="#450A0A" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,16" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorMessage" Text="" TextWrapping="Wrap" Foreground="#FCA5A5" FontSize="12"/>
                </Border>

                <!-- Input Controls -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="API Endpoint" FontWeight="SemiBold" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtApiUrl" Text="http://127.0.0.1:8000/api" Padding="10,8" FontSize="12" Background="#0F172A" Foreground="#F1F5F9" BorderBrush="#334155" Margin="0,0,0,12"/>

                    <TextBlock Text="Email Address" FontWeight="SemiBold" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtEmail" Text="owner@delivergate.lk" Padding="10,8" FontSize="13" Background="#0F172A" Foreground="#F1F5F9" BorderBrush="#334155" Margin="0,0,0,12"/>

                    <TextBlock Text="Password" FontWeight="SemiBold" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="TxtPassword" Password="password123" Padding="10,8" FontSize="13" Background="#0F172A" Foreground="#F1F5F9" BorderBrush="#334155" Margin="0,0,0,18"/>

                    <Button x:Name="BtnLogin" Content="Log In to Shop" Height="40" Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand" Click="LoginButton_Click"/>
                </StackPanel>

                <!-- Quick Test Roles Section -->
                <StackPanel Grid.Row="3" Margin="0,16,0,0">
                    <TextBlock Text="Quick Sign-in (Pre-Seeded Roles):" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                    <UniformGrid Columns="3">
                        <Button Content="👑 Owner" Height="28" Margin="0,0,4,0" Background="#1E3A8A" Foreground="#BFDBFE" BorderThickness="0" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Click="FillOwner_Click"/>
                        <Button Content="📋 Manager" Height="28" Margin="2,0,2,0" Background="#14532D" Foreground="#BBF7D0" BorderThickness="0" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Click="FillManager_Click"/>
                        <Button Content="💳 Cashier" Height="28" Margin="4,0,0,0" Background="#78350F" Foreground="#FED7AA" BorderThickness="0" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Click="FillCashier_Click"/>
                    </UniformGrid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
