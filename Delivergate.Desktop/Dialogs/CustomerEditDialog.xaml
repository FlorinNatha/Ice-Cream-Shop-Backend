<Window x:Class="Delivergate.Desktop.Dialogs.CustomerEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Customer Record" Height="480" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC" FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="DialogTitleText" Text="Add New Customer" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="Enter customer contact information and dietary notes." FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Error Banner -->
        <Border Grid.Row="1" x:Name="ErrorBanner" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,14" Visibility="Collapsed">
            <TextBlock x:Name="ErrorText" Text="" TextWrapping="Wrap" Foreground="#991B1B" FontSize="12"/>
        </Border>

        <!-- Form Fields -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Full Name *" FontWeight="SemiBold" Foreground="#334155" FontSize="13" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtName" Padding="8,6" FontSize="13" BorderBrush="#CBD5E1" Margin="0,0,0,12"/>

                <TextBlock Text="Email Address" FontWeight="SemiBold" Foreground="#334155" FontSize="13" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtEmail" Padding="8,6" FontSize="13" BorderBrush="#CBD5E1" Margin="0,0,0,12"/>

                <TextBlock Text="Phone Number" FontWeight="SemiBold" Foreground="#334155" FontSize="13" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtPhone" Padding="8,6" FontSize="13" BorderBrush="#CBD5E1" Margin="0,0,0,12"/>

                <TextBlock Text="Address" FontWeight="SemiBold" Foreground="#334155" FontSize="13" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtAddress" Padding="8,6" FontSize="13" Height="50" TextWrapping="Wrap" AcceptsReturn="True" BorderBrush="#CBD5E1" Margin="0,0,0,12"/>

                <TextBlock Text="Notes &amp; Preferences" FontWeight="SemiBold" Foreground="#334155" FontSize="13" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtNotes" Padding="8,6" FontSize="13" Height="60" TextWrapping="Wrap" AcceptsReturn="True" BorderBrush="#CBD5E1" Margin="0,0,0,12"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="90" Height="34" Margin="0,0,10,0" Background="#E2E8F0" Foreground="#334155" BorderThickness="0" FontWeight="SemiBold" Click="CancelButton_Click" Cursor="Hand"/>
            <Button x:Name="BtnSave" Content="Save Customer" Width="130" Height="34" Background="#059669" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Click="SaveButton_Click" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
