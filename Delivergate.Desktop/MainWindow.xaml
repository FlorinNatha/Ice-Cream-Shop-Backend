<Window x:Class="Delivergate.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delivergate - Ice Cream Shop Management System" Height="720" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: App Navigation & Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1: RBAC Permissions Status Strip -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Notification / Toast Banner -->
            <RowDefinition Height="Auto"/>
            <!-- 3: Main Tab Content -->
            <RowDefinition Height="*"/>
            <!-- 4: Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="#0F172A" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand & Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🍦" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Delivergate" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <TextBlock Text="Ice Cream Shop Portal" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>

                <!-- User Profile & Role Badge -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,14,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtUserName" Text="Loading User..." FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="TxtUserEmail" Text="user@delivergate.lk" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Right"/>
                    </StackPanel>

                    <!-- Role Badge -->
                    <Border x:Name="RoleBadgeBorder" Background="#2563EB" CornerRadius="12" Padding="10,4" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtRoleBadge" Text="OWNER" FontWeight="Bold" FontSize="11" Foreground="White"/>
                    </Border>

                    <!-- Sign Out Button -->
                    <Button Content="Sign Out" Height="32" Padding="14,0" Background="#334155" Foreground="#E2E8F0" BorderThickness="0" FontWeight="SemiBold" FontSize="12" Cursor="Hand" Click="SignOutButton_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- RBAC Permissions Status Strip -->
        <Border Grid.Row="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,1,0,1" Padding="20,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Role-Based Permissions:" FontWeight="SemiBold" Foreground="#94A3B8" FontSize="12" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtRbacSummary" Text="Owner: Full CRUD access to inventory items and customer records." Foreground="#CBD5E1" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Action / Error Notification Banner -->
        <Border Grid.Row="2" x:Name="NotificationBanner" Visibility="Collapsed" Padding="16,10" Margin="20,12,20,0" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="NotificationMessage" Text="" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="✕" Width="24" Height="24" Background="Transparent" BorderThickness="0" FontWeight="Bold" Foreground="#64748B" Cursor="Hand" Click="DismissNotification_Click"/>
            </Grid>
        </Border>

        <!-- Main Tab Control -->
        <TabControl Grid.Row="3" Margin="20,14,20,14" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="16,10"/>
                    <Setter Property="Margin" Value="0,0,4,0"/>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1: INVENTORY MANAGEMENT -->
            <TabItem Header="🍦  Inventory Management">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filter & Action Toolbar -->
                    <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Search Input -->
                            <TextBox Grid.Column="0" x:Name="TxtItemSearch" Padding="8,6" FontSize="13" BorderBrush="#CBD5E1" Text="" ToolTip="Search by item name or flavor..." KeyDown="ItemSearch_KeyDown"/>

                            <!-- Category Dropdown -->
                            <ComboBox Grid.Column="2" x:Name="CmbItemCategory" Padding="8,6" FontSize="13" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="ItemCategory_SelectionChanged"/>

                            <!-- Search & Reset Buttons -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal">
                                <Button Content="🔍 Search" Height="34" Padding="12,0" Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="SemiBold" FontSize="12" Margin="0,0,8,0" Cursor="Hand" Click="SearchItems_Click"/>
                                <Button Content="Reset" Height="34" Padding="12,0" Background="#F1F5F9" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="SemiBold" FontSize="12" Margin="0,0,8,0" Cursor="Hand" Click="ResetItems_Click"/>
                                <Button Content="🔄 Refresh" Height="34" Padding="12,0" Background="#F1F5F9" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="SemiBold" FontSize="12" Cursor="Hand" Click="RefreshItems_Click"/>
                            </StackPanel>

                            <!-- Add Item Button (Owner & Manager only) -->
                            <Button Grid.Column="6" x:Name="BtnAddItem" Content="➕ Add New Item" Height="34" Padding="16,0" Background="#059669" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="13" Cursor="Hand" Click="AddItem_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Items DataGrid -->
                    <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
                        <DataGrid x:Name="GridItems" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" HorizontalGridLinesBrush="#F1F5F9" Background="White" RowHeight="42" FontSize="13" SelectionMode="Single">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                    <Setter Property="Foreground" Value="#475569"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="12,8"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                                <DataGridTextColumn Header="Item Name" Binding="{Binding Name}" Width="220" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="130"/>
                                <DataGridTextColumn Header="Flavor" Binding="{Binding Flavor}" Width="160"/>
                                <DataGridTextColumn Header="Price (LKR)" Binding="{Binding PriceFormatted}" Width="110"/>
                                <DataGridTextColumn Header="Stock" Binding="{Binding StockQuantity}" Width="80"/>
                                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="70"/>
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                                <DataGridTemplateColumn Header="Actions" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="✏️ Edit" Height="26" Padding="8,0" Margin="0,0,6,0" Background="#EFF6FF" Foreground="#1D4ED8" BorderBrush="#BFDBFE" BorderThickness="1" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Click="EditItemRow_Click" Tag="{Binding}"/>
                                                <Button x:Name="BtnDeleteRow" Content="🗑️" Height="26" Width="28" Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1" FontSize="11" FontWeight="Bold" Cursor="Hand" Click="DeleteItemRow_Click" Tag="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: CUSTOMER MANAGEMENT -->
            <TabItem Header="👥  Customer Records">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filter & Action Toolbar -->
                    <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Search Input -->
                            <TextBox Grid.Column="0" x:Name="TxtCustomerSearch" Padding="8,6" FontSize="13" BorderBrush="#CBD5E1" Text="" ToolTip="Search by name, email, or phone..." KeyDown="CustomerSearch_KeyDown"/>

                            <!-- Search & Reset Buttons -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="🔍 Search" Height="34" Padding="12,0" Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="SemiBold" FontSize="12" Margin="0,0,8,0" Cursor="Hand" Click="SearchCustomers_Click"/>
                                <Button Content="Reset" Height="34" Padding="12,0" Background="#F1F5F9" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="SemiBold" FontSize="12" Margin="0,0,8,0" Cursor="Hand" Click="ResetCustomers_Click"/>
                                <Button Content="🔄 Refresh" Height="34" Padding="12,0" Background="#F1F5F9" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="SemiBold" FontSize="12" Cursor="Hand" Click="RefreshCustomers_Click"/>
                            </StackPanel>

                            <!-- Add Customer Button (Allowed for all roles) -->
                            <Button Grid.Column="4" x:Name="BtnAddCustomer" Content="➕ Add New Customer" Height="34" Padding="16,0" Background="#059669" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="13" Cursor="Hand" Click="AddCustomer_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Customers DataGrid -->
                    <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
                        <DataGrid x:Name="GridCustomers" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" HorizontalGridLinesBrush="#F1F5F9" Background="White" RowHeight="42" FontSize="13" SelectionMode="Single">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                    <Setter Property="Foreground" Value="#475569"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="12,8"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                                <DataGridTextColumn Header="Customer Name" Binding="{Binding Name}" Width="190" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>
                                <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="130"/>
                                <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="200"/>
                                <DataGridTextColumn Header="Notes / Preferences" Binding="{Binding Notes}" Width="*"/>
                                <DataGridTemplateColumn Header="Actions" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="✏️ Edit" Height="26" Padding="8,0" Margin="0,0,6,0" Background="#EFF6FF" Foreground="#1D4ED8" BorderBrush="#BFDBFE" BorderThickness="1" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Click="EditCustomerRow_Click" Tag="{Binding}"/>
                                                <Button Content="🗑️" Height="26" Width="28" Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1" FontSize="11" FontWeight="Bold" Cursor="Hand" Click="DeleteCustomerRow_Click" Tag="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="4" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock x:Name="TxtItemStats" Text="Items: 0" FontSize="12" Foreground="#64748B" Margin="0,0,16,0"/>
                    <TextBlock x:Name="TxtCustomerStats" Text="Customers: 0" FontSize="12" Foreground="#64748B"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="Server: 127.0.0.1:8000" FontSize="12" Foreground="#64748B" Margin="0,0,16,0"/>
                    <TextBlock Text="🟢 Online" FontSize="12" FontWeight="SemiBold" Foreground="#10B981"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
